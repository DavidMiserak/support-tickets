# Copy to .env and adjust as needed. Values here are read by app.config.Settings.

# Database — async SQLAlchemy URL (note the +asyncpg driver).
# Defaults to localhost for local (non-container) runs. The Compose stack sets
# its own DATABASE_URL (host "db"), which overrides this file inside containers.
DATABASE_URL=postgresql+asyncpg://ticketsupport:ticketsupport@localhost:5432/ticketsupport

# Redis — used by the arq background worker queue.
# Defaults to localhost for local (non-container) runs. The Compose stack
# overrides this to redis://redis:6379 inside containers.
REDIS_URL=redis://localhost:6379

# Background summarizer backend. Options: noop, transformer
# "noop" is safe for local development — no model download required.
# For "transformer", install ML deps first: pip install -r requirements-ml.txt
# (~300 MB HuggingFace model download on first worker run).
SUMMARIZER_BACKEND=noop

# Log verbosity. Options: DEBUG INFO WARNING ERROR CRITICAL
# Uncomment and change to get verbose output without editing compose.yaml.
# LOG_LEVEL=DEBUG

# Set true to enable debug behavior.
DEBUG=false
