# Copy to .env and adjust as needed. Values here are read by app.config.Settings.

# Database — async SQLAlchemy URL (note the +asyncpg driver).
# Docker Compose uses the "db" hostname; for local runs use localhost.
DATABASE_URL=postgresql+asyncpg://ticketsupport:ticketsupport@db:5432/ticketsupport

# Redis — used by the background worker queue (Phase 3, not yet wired up).
REDIS_URL=redis://redis:6379

# Set true to enable debug behavior.
DEBUG=false
